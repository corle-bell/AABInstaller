<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/download_settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchParallel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/download_parallel" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/download_segments"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <RadioGroup
                android:id="@+id/segmentGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/segment2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_segments_2" />

                <RadioButton
                    android:id="@+id/segment4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_segments_4" />

                <RadioButton
                    android:id="@+id/segment8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/download_segments_8" />
            </RadioGroup>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchLargeBuffer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/download_large_buffer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/download_settings_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
